{
  "name": "homebridge-pagerduty",
  "displayName": "Homebridge PagerDuty",
  "version": "2.1.1",
  "description": "Homebridge plugin that pages through PagerDuty: each alert is a HomeKit switch that triggers and resolves a PagerDuty alert, with severity levels, resolve timers, a maintenance switch, a delivery-fault sensor and a local signal store other plugins can raise alerts through",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "pagerduty",
    "alerting",
    "paging",
    "incident",
    "homekit"
  ],
  "author": {
    "name": "tbaur",
    "url": "https://github.com/tbaur"
  },
  "maintainers": [
    {
      "name": "tbaur",
      "url": "https://github.com/tbaur"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tbaur"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbaur/homebridge-pagerduty.git"
  },
  "bugs": {
    "url": "https://github.com/tbaur/homebridge-pagerduty/issues"
  },
  "homepage": "https://github.com/tbaur/homebridge-pagerduty#readme",
  "overrides": {
    "js-yaml": "^4.3.2",
    "brace-expansion": "^5.0.12",
    "handlebars": "^4.7.10"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "homebridge": "^2.4.0",
    "jest": "^30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.13.0 || ^24 || ^26"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch --coverage=false",
    "test:unit": "npm run build && NODE_ENV=test jest --coverage --testPathPatterns tests/unit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "files": [
    "dist/**/*",
    "config.schema.json",
    "docs/**/*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ]
}
